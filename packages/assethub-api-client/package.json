{
  "name": "@assethub/api-client",
  "version": "0.1.8",
  "description": "Typed client for the public AssetHub API.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AssetHub-inc/assethub-cli.git",
    "directory": "packages/assethub-api-client"
  },
  "homepage": "https://github.com/AssetHub-inc/assethub-cli#readme",
  "bugs": {
    "url": "https://github.com/AssetHub-inc/assethub-cli/issues"
  }
}
