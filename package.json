{
  "name": "assethub-cli-repository",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/assethub-api-client",
    "packages/assethub-cli"
  ],
  "scripts": {
    "build": "npm run build --workspace @assethub/api-client && npm run build --workspace @assethub/cli",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check": "npm run build && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "license": "MIT"
}
